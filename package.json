{
  "name": "gemini-web-gateway",
  "version": "1.0.0",
  "description": "Minimal local OpenAI-compatible gateway for Gemini Web",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
