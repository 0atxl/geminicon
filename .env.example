GEMINICON_MODE=local
HOST=127.0.0.1
PORT=8765

# Required to bind local Playwright mode beyond loopback.
GEMINICON_ALLOW_PUBLIC_LOCAL=false

# Hub deployments should publish an HTTPS URL (TLS may terminate at a proxy).
# GEMINICON_PUBLIC_URL=https://gateway.example.com
# Only for loopback-only hub development.
GEMINICON_ALLOW_INSECURE_HUB=false

# Required in hub mode to authenticate client backend callers.
GEMINICON_SERVICE_KEY=your-secret-service-key-here

# Path to the device registry JSON file.
# GEMINICON_DEVICES_PATH=.geminicon-devices.json

HEADLESS=true
BROWSER_PROFILE_PATH=./browser-data/profile

GENERATION_TIMEOUT_MS=180000
QUEUE_MAX_SIZE=20

LOG_LEVEL=info
LOG_CONTENT=false
