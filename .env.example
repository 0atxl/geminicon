GEMINICON_MODE=local
HOST=127.0.0.1
PORT=8765

# Acknowledges the warning when local Playwright mode listens beyond loopback.
GEMINICON_ALLOW_PUBLIC_LOCAL=false

# Hub deployments should publish an HTTPS URL (TLS may terminate at a proxy).
# GEMINICON_PUBLIC_URL=https://gateway.example.com
# Only for loopback-only hub development.
GEMINICON_ALLOW_INSECURE_HUB=false

HEADLESS=true
BROWSER_PROFILE_PATH=./browser-data/profile

GENERATION_TIMEOUT_MS=180000
QUEUE_MAX_SIZE=20

LOG_LEVEL=info
LOG_CONTENT=false
