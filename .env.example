# Operating mode: "hub" (Chrome Extension relay, recommended) or "local" (headless Playwright)
GEMINICON_MODE=hub

HOST=127.0.0.1
PORT=8765

# Local mode Playwright settings (only needed if GEMINICON_MODE=local)
HEADLESS=true
BROWSER_PROFILE_PATH=./browser-data/profile

GENERATION_TIMEOUT_MS=180000
QUEUE_MAX_SIZE=20

LOG_LEVEL=info
LOG_CONTENT=false
